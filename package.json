{
  "name": "datui-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter datui test",
    "build": "pnpm --filter datui build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm inventory",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "e2e": "playwright test",
    "inventory": "node scripts/inventory.mjs check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "axe-core": "4.14.0",
    "typescript": "6.0.3"
  }
}
